+// ----- A synced 3-2-1 when the host starts the timer with guests around
+
+let countdownTimer = 0;
+function runCountdown(go, onGo) {
+  clearInterval(countdownTimer);
+  const box = $('#countdown');
+  if (!go) {
+    box.hidden = true;
+    return;
+  }
+  const step = () => {
+    const left = Math.ceil((go - Date.now()) / 1000);
+    if (left <= 0) {
+      clearInterval(countdownTimer);
+      box.hidden = true;
+      if (onGo) onGo();
+      return;
+    }
+    if (box.textContent !== String(left)) {
+      box.textContent = String(left);
+      box.classList.remove('is-tick');
+      void box.offsetWidth;
+      box.classList.add('is-tick');
+      audio.sfx('tick', box);
+    }
+  };
+  box.hidden = false;
+  box.textContent = '';
+  step();
+  countdownTimer = setInterval(step, 100);
+}
